{
    "name": "Dotnet",
    "dockerFile": "Dockerfile",
    "extensions": [
        "ms-dotnettools.csharp",
        "shd101wyy.markdown-preview-enhanced"
    ],
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y nodejs npm",
    "forwardPorts": [
        5000,
        5001
    ],
    "remoteUser": "dotnet",
    "remoteEnv": {
        "SHELL": "/bin/bash"
    }
}